{
  "version": 2,
  "updated": "2026-10-22",
  "sites": [
    {
      "id": "amazon",
      "name": "Amazon",
      "base": "https://www.amazon.in",
      "search": "https://www.amazon.in/s?k={q}",
      "categories": ["beauty", "fashion", "electronics", "grocery", "home", "general"],
      "app": "in.amazon.mShop.android.shopping",
      "selectors": {
        "item": "[data-component-type=s-search-result]",
        "title": "h2[aria-label]",
        "titleAttr": "aria-label",
        "brand": "h2:not([aria-label])",
        "price": ".a-price:not(.a-text-price) .a-offscreen",
        "mrp": ".a-price[data-a-strike] .a-offscreen",
        "link": "a[href*='/dp/']",
        "idAttr": "data-asin",
        "urlTemplate": "/dp/{id}",
        "image": "img.s-image",
        "rating": "[aria-label*='out of 5'], .a-icon-alt",
        "ratingCount": "[aria-label$=' ratings'], [aria-label$=' rating']"
      },
      "blockedMarkers": ["Enter the characters you see below", "api-services-support@amazon.com"],
      "emptyMarkers": ["No results for", "did not match any products", "Try checking your spelling"],
      "fees": {
        "delivery": 40,
        "freeAbove": 499,
        "freeWith": ["prime"],
        "note": "Free delivery on orders of ₹499+ fulfilled by Amazon, or with Prime. Below that usually ₹40; seller-shipped items set their own charge.",
        "verified": "2026-10-22"
      }
    },
    {
      "id": "flipkart",
      "name": "Flipkart",
      "base": "https://www.flipkart.com",
      "search": "https://www.flipkart.com/search?q={q}",
      "categories": ["beauty", "fashion", "electronics", "grocery", "home", "general"],
      "app": "com.flipkart.android",
      "json": {
        "name": ["titles.title"],
        "brand": ["productBrand"],
        "extra": ["titles.subtitle"],
        "price": ["pricing.displayPrice", "pricing.finalPrice"],
        "mrp": ["pricing.strikeOffPrice", "pricing.mrp"],
        "url": [],
        "urlTemplate": "/product/p/itme?pid={productMeta.productId}",
        "image": ["images.0.imageUrl", "media.images.0.url"],
        "rating": ["rating.average"],
        "ratingCount": ["rating.count"]
      },
      "blockedMarkers": ["Are you a human", "recaptcha"],
      "fees": { "note": "Flipkart may add a platform fee and a delivery charge on small orders; they are shown at checkout.", "verified": "2026-10-22" }
    },
    {
      "id": "nykaa",
      "name": "Nykaa",
      "base": "https://www.nykaa.com",
      "search": "https://www.nykaa.com/search/result/?q={q}",
      "categories": ["beauty", "fashion"],
      "app": "com.fsn.nykaa",
      "fees": {
        "delivery": 70,
        "freeAbove": 299,
        "freeWith": ["nykaa-prive"],
        "note": "₹70 delivery on orders below ₹299 (free for Prive Gold/Platinum).",
        "verified": "2026-10-22"
      }
    },
    {
      "id": "myntra",
      "name": "Myntra",
      "base": "https://www.myntra.com",
      "search": "https://www.myntra.com/{q}",
      "slugQuery": true,
      "categories": ["beauty", "fashion", "home"],
      "app": "com.myntra.android",
      "json": {
        "name": ["productInfo.additionalInfo"],
        "brand": ["productInfo.brand"],
        "price": ["productInfo.priceInfo.price"],
        "mrp": ["productInfo.priceInfo.mrp"],
        "url": [],
        "urlTemplate": "/{styleId}",
        "image": ["productImage.productMedia.0.src"],
        "rating": ["productInfo.ratingInfo.rating"],
        "coupon": ["productInfo.couponData.text", "couponData.text"],
        "ratingCount": ["productInfo.ratingInfo.count"]
      },
      "fees": { "note": "Myntra adds a small platform fee (about ₹20-25) and may charge delivery on small orders.", "verified": "2026-10-22" }
    },
    {
      "id": "meesho",
      "name": "Meesho",
      "base": "https://www.meesho.com",
      "search": "https://www.meesho.com/api/v1/products/search",
      "manual": "https://www.meesho.com/search?q={q}",
      "request": {
        "method": "POST",
        "headers": { "Content-Type": "application/json", "Accept": "application/json" },
        "body": "{\"query\":\"{q}\",\"type\":\"text_search\",\"page\":1,\"offset\":0,\"limit\":20,\"isDevicePhone\":true}"
      },
      "categories": ["beauty", "fashion", "home", "general"],
      "productOffers": false,
      "app": "com.meesho.supply",
      "json": {
        "name": ["name"],
        "price": ["min_product_price", "min_catalog_price"],
        "mrp": ["original_price"],
        "url": [],
        "urlTemplate": "/{slug}/p/{product_id}",
        "image": ["image"],
        "rating": ["catalog_reviews_summary.average_rating"],
        "ratingCount": ["catalog_reviews_summary.rating_count"],
        "coupon": ["special_offers.display_text"]
      }
    },
    {
      "id": "ajio",
      "name": "Ajio",
      "base": "https://www.ajio.com",
      "search": "https://www.ajio.com/search/?text={q}",
      "categories": ["beauty", "fashion"],
      "app": "com.ril.ajio",
      "json": {
        "brand": ["fnlColorVariantData.brandName", "brandName"],
        "mrp": ["wasPriceData.value", "mrp"],
        "price": ["price.value", "price"],
        "coupon": ["offerPrice.value"]
      }
    },
